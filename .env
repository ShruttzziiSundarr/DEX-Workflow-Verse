# To use persistent PostgreSQL (Neon), set a real Neon connection string:
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# If left empty or set to 'memory', the app will use in-memory storage (data resets on restart)
DATABASE_URL=memory

SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com